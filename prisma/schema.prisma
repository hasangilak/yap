generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Chat-box conversation. The wire shape exposed at /api/v1/conversations
/// has a display-name `agent` field and a display-string `updated` field;
/// those are computed from `agentId` (via Agent.name) and `updatedAt`.
model Conversation {
  id             String   @id
  title          String
  snippet        String   @default("")
  agentId        String   @map("agent_id")
  tag            String?
  pinned         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  rootNodeId     String?  @map("root_node_id")
  activeLeafId   String?  @map("active_leaf_id")
  tokenBudget    Int      @default(200000) @map("token_budget")
  tokensUsed     Int      @default(0)      @map("tokens_used")
  /// Phase 7: non-null when the conversation is shared publicly via
  /// GET /shared/:token. DELETE /share nulls it to revoke.
  shareToken     String?  @unique @map("share_token")

  nodes  Node[]
  events Event[]
  tags   ConversationTag[]

  @@index([pinned(sort: Desc), updatedAt(sort: Desc)])
  @@map("conversations")
}

/// Phase 7: workspace-level tag catalog. Conversations attach via
/// the ConversationTag join so one conversation can carry many tags.
/// The legacy single-tag `Conversation.tag` column stays for now as
/// the primary display tag; m2m attachment augments it.
model Tag {
  id        String   @id
  name      String   @unique
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  conversations ConversationTag[]

  @@map("tags")
}

model ConversationTag {
  conversationId String @map("conversation_id")
  tagId          String @map("tag_id")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tagId])
  @@map("conversation_tags")
}

/// Phase 7: one free-form note per conversation (upserted on PUT).
model ThreadNote {
  conversationId String   @id @map("conversation_id")
  body           String   @default("")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("thread_notes")
}

/// Phase 7: a user-pinned excerpt pulled from a specific node,
/// surfaced in the Inspector Notes tab.
model PinnedSnippet {
  id             String   @id
  conversationId String   @map("conversation_id")
  sourceNodeId   String   @map("source_node_id")
  label          String
  excerpt        String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("pinned_snippets")
}

/// One message in the conversation tree. The wire shape omits several
/// server-internal fields (parent_id → parent, edited_from_id absent).
/// `role` is strictly 'user' | 'asst' — client does not accept
/// 'assistant'.
model Node {
  id             String   @id
  conversationId String   @map("conversation_id")
  parentId       String?  @map("parent_id")
  role           String
  branch         String   @default("main")
  content        String   @default("")
  reasoning      Json?
  toolCall       Json?    @map("tool_call")
  clarify        Json?
  approval       Json?
  streaming      Boolean  @default(false)
  status         String?
  /// Set by `POST /conversations/:id/cancel` — the user asked this turn to
  /// stop. Durable rather than in-memory because boot recovery replays
  /// unfinished turns: an in-memory flag would let a restart resurrect a turn
  /// the user had already stopped. Also what makes a late
  /// `POST /prompts/:id/respond` a 409 instead of resuming a cancelled turn.
  cancelRequested Boolean @default(false) @map("cancel_requested")
  edited         Boolean  @default(false)
  editedFromId   String?  @map("edited_from_id")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, branch, createdAt])
  @@map("nodes")
}

/// Wire Agent is { id, name, initial, desc, model, tools: number, temp }.
/// `tools` on the wire is a COUNT derived from toolIds length; the model
/// keeps the full array. Builder-form fields (systemPrompt etc.) are
/// surfaced via GET /agents/:id/full and editable via PATCH.
model Agent {
  id                String  @id
  name              String
  initial           String
  description       String  @default("")
  model             String
  temperature       Float   @default(0.5)
  topP              Float   @default(1.0) @map("top_p")
  maxTokens         Int     @default(4096) @map("max_tokens")
  systemPrompt      String  @default("") @map("system_prompt")
  toolIds           Json    @default("[]") @map("tool_ids")
  variables         Json    @default("[]")
  /// Phase 2: one of 'ask_every_time' | 'auto_allow_read' | 'auto_allow_all'.
  /// Drives whether a tool call needs an approval round-trip.
  permissionDefault String  @default("ask_every_time") @map("permission_default")
  /// Phase 4: id of the AgentVersion that represents the current saved
  /// state. Updated on every PATCH that writes a new version.
  currentVersionId  String? @map("current_version_id")
  /// Phase 4: soft-delete marker. Rows with a non-null deletedAt are
  /// hidden from listings but kept around so version history survives.
  deletedAt         DateTime? @map("deleted_at")

  versions          AgentVersion[]

  @@map("agents")
}

/// Phase 4: every PATCH /agents/:id that changes agent state writes
/// one of these. snapshot is the full materialized Agent at save time;
/// version is a monotonic per-agent integer starting at 1.
model AgentVersion {
  id              String   @id
  agentId         String   @map("agent_id")
  version         Int
  message         String   @default("")
  snapshot        Json
  evalScore       Float?   @map("eval_score")
  parentVersionId String?  @map("parent_version_id")
  createdAt       DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([agentId])
  @@map("agent_versions")
}

/// One row per pause awaiting a human — a tool call needing approval, or an
/// `ask_clarification` question. Replaces the former separate `Approval` and
/// `Clarify` models: the graph handles both identically (persist the row,
/// `interrupt()`, resume with the response), so the fork existed only because
/// the two pauses were built in different phases. One table with a `kind`
/// discriminator means a resume path, a recovery scan, and a "what is this
/// turn waiting on?" query each have one shape instead of two.
///
/// The row is the durable record of the pause; the graph checkpoint is the
/// durable record of *where the turn was* when it paused. Both are needed:
/// this table answers "what is being asked" for the UI, the checkpoint
/// answers "how to continue".
model Prompt {
  id             String    @id
  conversationId String    @map("conversation_id")
  nodeId         String    @map("node_id")
  /// The graph thread this pause belongs to. Equal to `nodeId` today (one
  /// thread per turn), stored explicitly so multi-agent subgraph threads can
  /// diverge from the node they surface on without a migration.
  threadId       String    @map("thread_id")
  /// LangGraph's interrupt id, when the resume path knows it. Lets a response
  /// target one specific interrupt once several are open at once.
  interruptId    String?   @map("interrupt_id")
  /// 'approval' | 'clarify'
  kind           String
  /// Tool that triggered the pause. `ask_clarification` for clarify prompts.
  tool           String
  /// Kind-specific request data: ApprovalData or ClarifyData.
  payload        Json
  /// Kind-specific answer: {decision, edited_args?} or {selected_chip_ids,
  /// text}. Null until answered — the presence of this field is what makes a
  /// double-response a 409 rather than a second resume.
  response       Json?
  respondedAt    DateTime? @map("responded_at")
  /// Set when the owning turn is stopped before the user answers. A cancelled
  /// prompt is terminal and must not appear in pending queries or be resumed.
  cancelledAt    DateTime? @map("cancelled_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([nodeId])
  @@map("prompts")
}

/// User text pushed into a turn that is already running — mid-turn steering.
///
/// Durable on purpose. `POST /conversations/:id/interject` returns 200 as soon
/// as this row exists, so the user has been told we accepted their text;
/// holding it only in memory would let a restart discard it with no signal,
/// which is the same silent-loss failure the clarify path used to have. The
/// one piece of steering that stays in memory is the `AbortController` for the
/// in-flight model call (`runtime/graph/steering.ts`) — an open HTTP stream to
/// Ollama cannot outlive the process anyway.
///
/// `consumedAt` is set only *after* the round that folded the text in has
/// finished streaming. That makes delivery at-least-once: a crash mid-round
/// replays the interjection rather than dropping it. Re-injecting the same
/// steering is harmless; silently discarding it is not.
model Interjection {
  id             String    @id
  conversationId String    @map("conversation_id")
  /// Graph thread this steers — the assistant node id.
  nodeId         String    @map("node_id")
  text           String
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([nodeId, consumedAt])
  @@map("interjections")
}

/// Phase 8: idempotency record for mutating POST/PATCH/DELETE. Clients
/// pass an Idempotency-Key header; the first response is cached for
/// 24h so retries replay the same status + body instead of causing a
/// second side-effect.
model IdempotencyRecord {
  key         String
  method      String
  path        String
  status      Int
  contentType String   @default("application/json") @map("content_type")
  body        String
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([key, method, path])
  @@index([createdAt])
  @@map("idempotency_records")
}

/// Phase 2: persistent "allow always" grants keyed by (user, agent, tool).
/// userId is hardcoded 'local' until the multi-user phase lands.
model ApprovalGrant {
  userId    String   @map("user_id")
  agentId   String   @map("agent_id")
  toolId    String   @map("tool_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, agentId, toolId])
  @@map("approval_grants")
}

/// Phase 6: one Artifact per (conversation, path). Every write_file
/// call that hits an existing (conv, path) appends a new version; a
/// fresh path starts a new artifact row. title mirrors the path today
/// because there's no rename-path UI yet.
model Artifact {
  id               String    @id
  conversationId   String    @map("conversation_id")
  title            String
  mime             String    @default("text/plain")
  currentVersionId String?   @map("current_version_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  versions ArtifactVersion[]

  @@unique([conversationId, title])
  @@index([conversationId])
  @@map("artifacts")
}

/// Phase 6: immutable snapshot of artifact content at save time.
/// version is monotonic per-artifact starting at 1. author is 'asst'
/// for tool-call-produced versions and 'user' when a later phase
/// adds direct user edits.
model ArtifactVersion {
  id                 String   @id
  artifactId         String   @map("artifact_id")
  version            Int
  content            String
  diffFrom           String?  @map("diff_from")
  message            String   @default("")
  author             String
  producedByNodeId   String?  @map("produced_by_node_id")
  createdAt          DateTime @default(now()) @map("created_at")

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([artifactId, version])
  @@index([artifactId])
  @@map("artifact_versions")
}

/// Every BusEvent persisted before publication, so the SSE stream can
/// be resumed with ?since_event=<id>.
model Event {
  seq             BigInt   @id @default(autoincrement())
  id              String   @unique
  conversationId  String   @map("conversation_id")
  nodeId          String?  @map("node_id")
  kind            String
  payload         Json
  at              DateTime

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, seq])
  @@map("events")
}
